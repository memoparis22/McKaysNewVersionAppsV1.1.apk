import React, { useState, useEffect, useRef } from 'react';
import { 
  Users, ShoppingCart, Package, UserCheck, Settings, 
  LogOut, Plus, Trash2, Search, Calendar, FileText, 
  Download, Eye, EyeOff, Shield, RefreshCw, Upload,
  CheckCircle, ArrowUpRight, TrendingUp, DollarSign,
  ChevronRight, Box, Camera, Sun, Moon, AlertTriangle, X, Minus,
  Store, Bell
} from 'lucide-react';

// ============================================================================
// MAIN APPLICATION COMPONENT
// ============================================================================
export default function App() {
  const [currentUser, setCurrentUser] = useState(() => {
    const saved = localStorage.getItem('mckays_user_session');
    return saved ? JSON.parse(saved) : null;
  });

  const [currentTab, setCurrentTab] = useState('home');
  const [darkMode, setDarkMode] = useState(false);
  const [toastMessage, setToastMessage] = useState(null);
  const [priceNotification, setPriceNotification] = useState(null);

  const showToast = (msg) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 3000);
  };

  useEffect(() => {
    if (currentUser) {
      localStorage.setItem('mckays_user_session', JSON.stringify(currentUser));
    } else {
      localStorage.removeItem('mckays_user_session');
    }
  }, [currentUser]);

  // Master Pricing (Admin Controlled, synced globally)
  const [masterPrices, setMasterPrices] = useState({
    'VC Scandal': { price_ml: 4000, price_botol: 6000 },
    'PL Romantichwish': { price_ml: 3500, price_botol: 5000 },
    'Pink Shiffon': { price_ml: 3000, price_botol: 5000 },
    'ES Cherry': { price_ml: 4500, price_botol: 6000 },
    'Air ZR Nude': { price_ml: 3500, price_botol: 5000 }
  });

  // Master Staff Accounts
  const [staffAccounts, setStaffAccounts] = useState([
    { id: '1', username: 'budi', password: '123', branch: 'Bandung' },
    { id: '2', username: 'surabaya', password: '123', branch: 'Surabaya' }
  ]);

  // Branch Inventory (Bibit & Botol)
  const [branchInventory, setBranchInventory] = useState({
    'Pusat': [
      { id: '1', name: 'VC Scandal', stock_ml: 150, stock_botol: 50 },
      { id: '2', name: 'PL Romantichwish', stock_ml: 100, stock_botol: 30 },
      { id: '3', name: 'Pink Shiffon', stock_ml: 80, stock_botol: 40 },
      { id: '4', name: 'ES Cherry', stock_ml: 9, stock_botol: 5 }
    ],
    'Bandung': [
      { id: '1', name: 'VC Scandal', stock_ml: 50, stock_botol: 20 },
      { id: '2', name: 'Air ZR Nude', stock_ml: 8, stock_botol: 2 }
    ],
    'Surabaya': [
      { id: '1', name: 'Pink Shiffon', stock_ml: 45, stock_botol: 15 }
    ]
  });

  // Orders State
  const [stockOrders, setStockOrders] = useState([
    { id: 'ORD-01', branch: 'Bandung', item: 'VC Scandal', ml: 100, botol: 20, status: 'Menunggu Persetujuan' }
  ]);

  // Transactions State
  const [transactions, setTransactions] = useState([
    { id: 'TRX-1001', branch: 'Bandung', type: 'Kombinasi (Bibit + Botol)', item: 'VC Scandal (30ml) + Botol (1pcs)', detail: 'Kombinasi | 30ml | 1pcs', price: 150000, member: 'Siti Rahma', pointsEarned: 15, time: '10:30', date: new Date().toISOString().split('T')[0] }
  ]);

  // Members State
  const [members, setMembers] = useState([
    { id: '1', name: 'Siti Rahma', phone: '081234567890', points: 45 },
    { id: '2', name: 'Ahmad Fauzi', phone: '089876543210', points: 20 }
  ]);

  // Global App Logo (Admin controlled, synced to all staff)
  const [appLogo, setAppLogo] = useState(null);

  if (!currentUser) {
    return <LoginScreen setStaffAccounts={setStaffAccounts} staffAccounts={staffAccounts} setCurrentUser={setCurrentUser} showToast={showToast} darkMode={darkMode} setDarkMode={setDarkMode} appLogo={appLogo} />;
  }

  return (
    <div className={`min-h-screen pb-24 font-sans select-none transition-colors ${darkMode ? 'bg-gray-950 text-white dark' : 'bg-slate-50 text-slate-900'}`}>
      
      {/* Top Header */}
      <header className={`sticky top-0 z-30 px-4 py-3 flex justify-between items-center border-b backdrop-blur-md ${darkMode ? 'bg-gray-950/80 border-gray-800' : 'bg-white/80 border-slate-200'}`}>
        <div className="flex items-center gap-2.5">
          <div className="w-9 h-9 rounded-2xl bg-blue-600 flex items-center justify-center text-white shadow-lg shadow-blue-600/30 font-black overflow-hidden">
            {appLogo ? (
              <img src={appLogo} alt="Logo" className="w-full h-full object-cover" />
            ) : (
              'M'
            )}
          </div>
          <div>
            <h1 className="text-sm font-black leading-tight">McKays</h1>
            <p className="text-[10px] text-slate-400 font-semibold">{currentUser.role === 'admin' ? 'Admin Pusat' : `Cabang: ${currentUser.branch}`}</p>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button onClick={() => setDarkMode(!darkMode)} className="p-2 rounded-xl border dark:border-gray-800">
            {darkMode ? <Sun className="w-4 h-4 text-amber-400" /> : <Moon className="w-4 h-4" />}
          </button>
          <div className="w-9 h-9 rounded-full overflow-hidden border border-blue-600/40 bg-blue-600/20 flex items-center justify-center">
            {currentUser.profilePic ? (
              <img src={currentUser.profilePic} alt="Profile" className="w-full h-full object-cover" />
            ) : (
              <span className="text-xs font-bold text-blue-600">{currentUser.username.substring(0, 2).toUpperCase()}</span>
            )}
          </div>
        </div>
      </header>

      {/* Price Update Notification for Staff */}
      {priceNotification && currentUser.role !== 'admin' && (
        <div className="bg-blue-600 text-white text-xs px-4 py-2.5 font-bold flex justify-between items-center z-40 sticky top-[57px]">
          <span>{priceNotification}</span>
          <button onClick={() => setPriceNotification(null)}><X className="w-4 h-4" /></button>
        </div>
      )}

      {/* Main Content View */}
      <main className="max-w-md mx-auto">
        {currentTab === 'home' && (
          <HomeTab 
            currentUser={currentUser} 
            branchInventory={branchInventory} 
            setBranchInventory={setBranchInventory}
            transactions={transactions} 
            masterPrices={masterPrices}
            darkMode={darkMode} 
            showToast={showToast} 
          />
        )}
        {currentTab === 'stock' && (
          <StockTab 
            currentUser={currentUser} 
            branchInventory={branchInventory} 
            setBranchInventory={setBranchInventory}
            stockOrders={stockOrders}
            setStockOrders={setStockOrders}
            masterPrices={masterPrices}
            setMasterPrices={setMasterPrices}
            setPriceNotification={setPriceNotification}
            darkMode={darkMode} 
            showToast={showToast} 
          />
        )}
        {currentTab === 'history' && (
          <HistoryTab 
            currentUser={currentUser} 
            transactions={transactions} 
            darkMode={darkMode} 
            showToast={showToast} 
          />
        )}
        {currentTab === 'member' && (
          <MemberTab 
            currentUser={currentUser}
            members={members} 
            setMembers={setMembers} 
            showToast={showToast} 
            darkMode={darkMode} 
          />
        )}
        {currentTab === 'profile' && (
          <ProfileTab 
            currentUser={currentUser} 
            setCurrentUser={setCurrentUser}
            staffAccounts={staffAccounts}
            setStaffAccounts={setStaffAccounts}
            branchInventory={branchInventory}
            setBranchInventory={setBranchInventory}
            members={members}
            setMembers={setMembers}
            transactions={transactions}
            masterPrices={masterPrices}
            setMasterPrices={setMasterPrices}
            stockOrders={stockOrders}
            setStockOrders={setStockOrders}
            setPriceNotification={setPriceNotification}
            appLogo={appLogo}
            setAppLogo={setAppLogo}
            darkMode={darkMode}
            setDarkMode={setDarkMode}
            showToast={showToast}
          />
        )}
      </main>

      {/* Floating Bottom Navigation Bar */}
      <nav className={`fixed bottom-4 left-4 right-4 max-w-sm mx-auto rounded-3xl border p-1.5 flex justify-around items-center z-40 backdrop-blur-xl shadow-2xl ${darkMode ? 'bg-gray-900/90 border-gray-800' : 'bg-white/90 border-slate-200'}`}>
        <NavItem active={currentTab === 'home'} onClick={() => setCurrentTab('home')} icon={<TrendingUp className="w-5 h-5" />} label="Home" darkMode={darkMode} />
        <NavItem active={currentTab === 'stock'} onClick={() => setCurrentTab('stock')} icon={<Package className="w-5 h-5" />} label="Stok" darkMode={darkMode} />
        <NavItem active={currentTab === 'history'} onClick={() => setCurrentTab('history')} icon={<FileText className="w-5 h-5" />} label="Riwayat" darkMode={darkMode} />
        <NavItem active={currentTab === 'member'} onClick={() => setCurrentTab('member')} icon={<Users className="w-5 h-5" />} label="Member" darkMode={darkMode} />
        <NavItem active={currentTab === 'profile'} onClick={() => setCurrentTab('profile')} icon={<Settings className="w-5 h-5" />} label="Akun" darkMode={darkMode} />
      </nav>

      {/* Toast Notification */}
      {toastMessage && (
        <div className="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-5 py-3 rounded-2xl text-xs font-bold shadow-2xl flex items-center gap-2 animate-bounce">
          <CheckCircle className="w-4 h-4 text-emerald-400" />
          <span>{toastMessage}</span>
        </div>
      )}
    </div>
  );
}

function NavItem({ active, onClick, icon, label, darkMode }) {
  return (
    <button 
      onClick={onClick}
      className={`flex flex-col items-center py-2 px-3 rounded-2xl transition-all ${active ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/40 font-bold scale-105' : 'text-slate-400 hover:text-slate-600 dark:hover:text-slate-200'}`}
    >
      {icon}
      <span className="text-[10px] mt-1">{label}</span>
    </button>
  );
}

// ============================================================================
// 1. LOGIN SCREEN
// ============================================================================
function LoginScreen({ staffAccounts, setCurrentUser, showToast, darkMode, appLogo }) {
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [showPass, setShowPass] = useState(false);

  const handleLogin = (e) => {
    e.preventDefault();
    if (username === 'mckays' && password === 'bismillah22') {
      setCurrentUser({ username: 'mckays', role: 'admin', branch: 'Pusat' });
      showToast('Login berhasil sebagai Admin Pusat!');
      return;
    }

    const foundStaff = staffAccounts.find(s => s.username === username && s.password === password);
    if (foundStaff) {
      setCurrentUser({ username: foundStaff.username, role: 'staff', branch: foundStaff.branch });
      showToast(`Login berhasil sebagai Staff (${foundStaff.branch})!`);
      return;
    }

    alert('ID atau Password salah!');
  };

  return (
    <div className={`min-h-screen flex items-center justify-center p-6 transition-colors ${darkMode ? 'bg-gray-950 text-white' : 'bg-slate-50 text-slate-900'}`}>
      <div className={`w-full max-w-sm p-8 rounded-3xl border shadow-2xl space-y-6 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200'}`}>
        
        <div className="text-center space-y-2">
          <div className="w-16 h-16 rounded-3xl bg-blue-600 mx-auto flex items-center justify-center text-white shadow-xl shadow-blue-600/40 text-2xl font-black overflow-hidden">
            {appLogo ? (
              <img src={appLogo} alt="Logo" className="w-full h-full object-cover" />
            ) : (
              'M'
            )}
          </div>
          <h1 className="text-xl font-black tracking-tight">McKays</h1>
        </div>

        <form onSubmit={handleLogin} className="space-y-4">
          <div>
            <label className="text-xs font-bold text-slate-400 mb-1 block">ID</label>
            <input 
              type="text" 
              required
              placeholder="ID"
              value={username}
              onChange={(e) => setUsername(e.target.value)}
              className="w-full px-4 py-3.5 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-sm font-semibold"
            />
          </div>

          <div>
            <label className="text-xs font-bold text-slate-400 mb-1 block">Insert Password</label>
            <div className="relative">
              <input 
                type={showPass ? 'text' : 'password'} 
                required
                placeholder="Insert password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                className="w-full px-4 py-3.5 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-sm font-semibold pr-12"
              />
              <button 
                type="button" 
                onClick={() => setShowPass(!showPass)}
                className="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"
              >
                {showPass ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
              </button>
            </div>
          </div>

          <button 
            type="submit"
            className="w-full py-4 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-xl shadow-blue-600/30 transition"
          >
            LOGIN
          </button>
        </form>
      </div>
    </div>
  );
}

