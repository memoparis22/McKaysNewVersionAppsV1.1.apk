            <input type="text" placeholder="Nama Cabang (cth: Medan)" required value={newStaffBranch} onChange={(e) => setNewStaffBranch(e.target.value)} className="w-full px-4 py-2.5 rounded-xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-medium" />
