// 2. HOME TAB
// ============================================================================
function HomeTab({ currentUser, branchInventory, setBranchInventory, transactions, masterPrices, darkMode, showToast }) {
  const isAdmin = currentUser.role === 'admin';
  const activeBranch = currentUser.branch;

  const [selectedDate, setSelectedDate] = useState(new Date().toISOString().split('T')[0]);
  const [isSalesModalOpen, setIsSalesModalOpen] = useState(false);

  const dateTx = transactions.filter(tx => tx.date === selectedDate && (isAdmin ? true : tx.branch === activeBranch));
  const totalOmzet = dateTx.reduce((sum, tx) => sum + tx.price, 0);

  const rawItems = branchInventory[isAdmin ? 'Pusat' : activeBranch] || [];
  const lowStockItems = rawItems.filter(i => (i.stock_ml || 0) < 10 || (i.stock_botol || 0) < 10).slice(0, 4);

  const bestSellers = ['VC Scandal', 'PL Romantichwish', 'Pink Shiffon', 'ES Cherry', 'Air ZR Nude'];
  const activeBestSellers = rawItems.filter(i => bestSellers.some(bs => i.name.toLowerCase().includes(bs.toLowerCase())));

  return (
    <div className="p-4 max-w-md mx-auto space-y-5">
      
      {/* Omset Card */}
      <div className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-700 to-indigo-800 p-6 text-white shadow-2xl">
        <div className="absolute right-[-20px] bottom-[-20px] opacity-15">
          <TrendingUp className="w-40 h-40" />
        </div>
        <div className="relative z-10 space-y-3">
          <div>
            <p className="text-xs text-blue-200 font-bold uppercase tracking-wider">Total Omset ({isAdmin ? 'Pusat' : activeBranch})</p>
            <h2 className="text-3xl font-black mt-1">Rp {totalOmzet.toLocaleString('id-ID')}</h2>
          </div>
          
          <div className="flex items-center gap-2 bg-white/15 backdrop-blur-md px-3.5 py-2 rounded-2xl w-fit border border-white/20">
            <Calendar className="w-4 h-4 text-blue-200" />
            <input 
              type="date"
              value={selectedDate}
              onChange={(e) => setSelectedDate(e.target.value)}
              className="bg-transparent text-xs font-bold text-white outline-none cursor-pointer"
            />
          </div>
        </div>
      </div>

      {/* Action Button: Buka Kasir Penjualan */}
      <button 
        onClick={() => setIsSalesModalOpen(true)}
        className="w-full py-4 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-sm shadow-xl shadow-blue-600/30 flex items-center justify-center gap-2 transition"
      >
        <ShoppingCart className="w-5 h-5" />
        Buka Kasir Penjualan
      </button>

      {/* Best Seller Section */}
      <div className="space-y-3">
        <h3 className="text-xs font-black uppercase tracking-wider text-slate-400">Best Seller</h3>
        <div className="grid grid-cols-2 gap-3">
          {activeBestSellers.length === 0 ? (
            <p className="text-xs text-slate-400 col-span-2 py-3 text-center">Belum ada item best seller di stok toko.</p>
          ) : (
            activeBestSellers.map((item) => (
              <div key={item.id} className={`p-3.5 rounded-2xl border ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
                <h4 className="font-extrabold text-xs truncate">{item.name}</h4>
                <div className="mt-2 flex justify-between items-center text-[10px]">
                  <span className="text-blue-500 font-bold">{item.stock_ml || 0}ml</span>
                  <span className="text-purple-500 font-bold">{item.stock_botol || 0}pcs</span>
                </div>
              </div>
            ))
          )}
        </div>
      </div>

      {/* Low Stock Warning Section (< 10) */}
      <div className="space-y-3">
        <h3 className="text-xs font-black uppercase tracking-wider text-rose-500 flex items-center gap-1.5">
          <AlertTriangle className="w-4 h-4" /> Stok Menipis (&lt; 10)
        </h3>
        <div className="space-y-2">
          {lowStockItems.length === 0 ? (
            <p className="text-xs text-slate-400 py-3 text-center">Semua stok aman.</p>
          ) : (
            lowStockItems.map((item) => (
              <div key={item.id} className={`p-3.5 rounded-2xl border flex justify-between items-center ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
                <span className="font-bold text-xs">{item.name}</span>
                <span className="text-xs font-black text-rose-500">
                  {item.stock_ml < 10 ? `${item.stock_ml}ml` : `${item.stock_botol}pcs`}
                </span>
              </div>
            ))
          )}
        </div>
      </div>

      {/* Sales Modal */}
      {isSalesModalOpen && (
        <SalesModal 
          currentUser={currentUser} 
          branchInventory={branchInventory} 
          setBranchInventory={setBranchInventory}
          transactions={transactions}
          setTransactions={setTransactions}
          masterPrices={masterPrices}
          onClose={() => setIsSalesModalOpen(false)}
          showToast={showToast}
          darkMode={darkMode}
        />
      )}
    </div>
  );
}

// ============================================================================
// 3. STOCK TAB
// ============================================================================
function StockTab({ currentUser, branchInventory, setBranchInventory, stockOrders, setStockOrders, masterPrices, setMasterPrices, setPriceNotification, darkMode, showToast }) {
  const isAdmin = currentUser.role === 'admin';
  const activeBranch = currentUser.branch;
  const rawItems = branchInventory[activeBranch] || [];

  const [searchTerm, setSearchTerm] = useState('');
  const [isOrderModalOpen, setIsOrderModalOpen] = useState(false);
  const [orderItemName, setOrderItemName] = useState('');
  const [orderMl, setOrderMl] = useState('');
  const [orderBotol, setOrderBotol] = useState('');

  const filteredItems = rawItems
    .filter(i => i.name.toLowerCase().includes(searchTerm.toLowerCase()))
    .sort((a, b) => a.name.localeCompare(b.name));

  const handleDeleteItem = (id) => {
    if (confirm('Hapus item produk ini dari stok?')) {
      const updated = { ...branchInventory };
      updated[activeBranch] = updated[activeBranch].filter(i => i.id !== id);
      setBranchInventory(updated);
      showToast('Item berhasil dihapus.');
    }
  };

  const handleUpdatePrice = (itemName, mlPrice, botolPrice) => {
    const updated = {
      ...masterPrices,
      [itemName]: { price_ml: parseFloat(mlPrice) || 0, price_botol: parseFloat(botolPrice) || 0 }
    };
    setMasterPrices(updated);
    setPriceNotification(`Harga ${itemName} telah diperbarui oleh Admin!`);
    showToast('Harga Master berhasil diperbarui & disinkronkan!');
  };

  const handleSendOrder = (e) => {
    e.preventDefault();
    if (!orderItemName.trim()) return;

    const newOrder = {
      id: `ORD-${Math.floor(100 + Math.random() * 900)}`,
      branch: activeBranch,
      item: orderItemName.trim(),
      ml: parseFloat(orderMl) || 0,
      botol: parseFloat(orderBotol) || 0,
      status: 'Menunggu Persetujuan'
    };

    setStockOrders([...stockOrders, newOrder]);
    setOrderItemName('');
    setOrderMl('');
    setOrderBotol('');
    setIsOrderModalOpen(false);
    showToast('Order berhasil dikirim ke Admin Pusat!');
  };

  return (
    <div className="p-4 max-w-md mx-auto space-y-4">
      <div className="flex justify-between items-center">
        <div>
          <h2 className="text-lg font-black">Katalog & Stok ({activeBranch})</h2>
          <p className="text-xs text-slate-400">Urut Abjad A-Z</p>
        </div>
        {!isAdmin && (
          <button 
            onClick={() => setIsOrderModalOpen(true)}
            className="px-4 py-2.5 rounded-2xl bg-blue-600 text-white font-bold text-xs shadow-lg shadow-blue-600/30"
          >
            Order Stok
          </button>
        )}
      </div>

      {/* Admin Master Pricing inside Stock Tab */}
      {isAdmin && (
        <div className={`p-4 rounded-3xl border space-y-3 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
          <h3 className="text-xs font-extrabold text-blue-500 uppercase tracking-wider">Kelola Harga Master (Per ml & Botol)</h3>
          <p className="text-[10px] text-slate-400">Perubahan harga otomatis tersinkron ke semua akun staff cabang.</p>
          <div className="space-y-2 max-h-48 overflow-y-auto">
            {Object.keys(masterPrices).map(itemName => (
              <div key={itemName} className="space-y-1 pb-2 border-b dark:border-gray-800 last:border-none">
                <span className="font-bold text-xs">{itemName}</span>
                <div className="grid grid-cols-2 gap-2">
                  <input 
                    type="number"
                    defaultValue={masterPrices[itemName].price_ml}
                    onBlur={(e) => handleUpdatePrice(itemName, e.target.value, masterPrices[itemName].price_botol)}
                    placeholder="Harga / ml"
                    className="px-3 py-2 rounded-xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold"
                  />
                  <input 
                    type="number"
                    defaultValue={masterPrices[itemName].price_botol}
                    onBlur={(e) => handleUpdatePrice(itemName, masterPrices[itemName].price_ml, e.target.value)}
                    placeholder="Harga Botol"
                    className="px-3 py-2 rounded-xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <div className="relative">
        <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
        <input 
          type="text"
          placeholder="Cari produk..."
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
          className="w-full pl-10 pr-4 py-3 rounded-2xl border dark:border-gray-700 bg-white dark:bg-gray-900 text-xs font-semibold"
        />
      </div>

      <div className="space-y-3">
        {filteredItems.length === 0 ? (
          <p className="text-center py-12 text-slate-400 text-xs">Belum ada stok.</p>
        ) : (
          filteredItems.map((item) => (
            <div key={item.id} className={`p-4 rounded-2xl border flex justify-between items-center ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
              <div>
                <h3 className="font-extrabold text-sm">{item.name}</h3>
                <div className="mt-1 flex gap-3 text-xs font-bold">
                  <span className="text-blue-500">Bibit: {item.stock_ml || 0}ml</span>
