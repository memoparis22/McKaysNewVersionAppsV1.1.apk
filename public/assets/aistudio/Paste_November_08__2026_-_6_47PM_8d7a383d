// 7. SALES MODAL
// ============================================================================
function SalesModal({ currentUser, branchInventory, setBranchInventory, transactions, setTransactions, masterPrices, onClose, showToast, darkMode }) {
  const activeBranch = currentUser.branch;
  const rawItems = branchInventory[activeBranch] || [];

  const [saleType, setSaleType] = useState('Kombinasi (Bibit + Botol)');
  const [selectedBibit, setSelectedBibit] = useState(rawItems[0] || null);
  const [takaranMl, setTakaranMl] = useState('0');
  const [jumlahBotol, setJumlahBotol] = useState('0');
  const [price, setPrice] = useState('0');
  const [member, setMember] = useState('Umum');

  // Auto calculate price based on Master Prices
  useEffect(() => {
    if (!selectedBibit) return;
    const ml = parseFloat(takaranMl) || 0;
    const botolPcs = parseFloat(jumlahBotol) || 0;
    const pricing = masterPrices[selectedBibit.name] || { price_ml: 4000, price_botol: 6000 };
    
    let calc = 0;
    if (saleType.includes('Kombinasi')) {
      calc = (pricing.price_ml * ml) + (pricing.price_botol * botolPcs);
    } else if (saleType.includes('Bibit')) {
      calc = pricing.price_ml * ml;
    } else if (saleType.includes('Botol')) {
      calc = pricing.price_botol * botolPcs;
    }
    setPrice(calc.toString());
  }, [selectedBibit, takaranMl, jumlahBotol, saleType, masterPrices]);

  const handleSubmit = (e) => {
    e.preventDefault();
    const mlVal = parseFloat(takaranMl) || 0;
    const botolVal = parseFloat(jumlahBotol) || 0;
    const priceVal = parseFloat(price) || 0;

    if (selectedBibit) {
      if (selectedBibit.stock_ml < mlVal) {
        alert('Stok bibit tidak mencukupi!');
        return;
      }
      if (selectedBibit.stock_botol < botolVal) {
        alert('Stok botol tidak mencukupi!');
        return;
      }

      const updated = { ...branchInventory };
      updated[activeBranch] = updated[activeBranch].map(item => {
        if (item.id === selectedBibit.id) {
          return {
            ...item,
            stock_ml: item.stock_ml - mlVal,
            stock_botol: item.stock_botol - botolVal
          };
        }
        return item;
      });
      setBranchInventory(updated);
    }

    const newTx = {
      id: `TRX-${Math.floor(1000 + Math.random() * 9000)}`,
      branch: activeBranch,
      type: saleType,
      item: selectedBibit ? `${selectedBibit.name} (${takaranMl}ml)` : 'Penjualan',
      detail: `${saleType} | ${takaranMl}ml | ${jumlahBotol}pcs`,
      price: priceVal,
      member: member,
      pointsEarned: Math.floor(priceVal / 10000),
      time: new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }),
      date: new Date().toISOString().split('T')[0]
    };

    setTransactions([newTx, ...transactions]);
    showToast('Transaksi berhasil disimpan!');
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
      <div className={`w-full max-w-lg rounded-t-3xl sm:rounded-3xl p-6 max-h-[90vh] overflow-y-auto space-y-4 ${darkMode ? 'bg-gray-900 text-white border border-gray-800' : 'bg-white text-slate-900'}`}>
        
        <div className="flex justify-between items-center pb-2 border-b dark:border-gray-800">
          <h3 className="font-black text-base">Kasir Terpadu ({activeBranch})</h3>
          <button onClick={onClose} className="p-2 rounded-full bg-slate-100 dark:bg-gray-800">
            <X className="w-4 h-4" />
          </button>
        </div>

        <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <label className="text-xs font-bold text-slate-400 mb-1 block">Tipe Penjualan</label>
            <select value={saleType} onChange={(e) => setSaleType(e.target.value)} className="w-full px-4 py-3 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold">
              <option>Kombinasi (Bibit + Botol)</option>
              <option>Bibit Saja</option>
              <option>Botol Saja</option>
            </select>
          </div>

          <div>
            <label className="text-xs font-bold text-slate-400 mb-1 block">Pilih Bibit / Parfum</label>
            <select 
              value={selectedBibit ? selectedBibit.id : ''}
              onChange={(e) => {
                const found = rawItems.find(i => i.id === e.target.value);
                setSelectedBibit(found);
              }}
              className="w-full px-4 py-3 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold"
            >
              {rawItems.map(item => (
                <option key={item.id} value={item.id}>
                  {item.name} (Bibit: {item.stock_ml}ml | Botol: {item.stock_botol}pcs)
                </option>
              ))}
            </select>
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div>
              <label className="text-xs font-bold text-slate-400 mb-1 block">Takaran (ml)</label>
              <input type="number" value={takaranMl} onChange={(e) => setTakaranMl(e.target.value)} className="w-full px-4 py-3 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold" />
            </div>
            <div>
              <label className="text-xs font-bold text-slate-400 mb-1 block">Jumlah Botol (pcs)</label>
              <input type="number" value={jumlahBotol} onChange={(e) => setJumlahBotol(e.target.value)} className="w-full px-4 py-3 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold" />
            </div>
          </div>

          <div>
            <label className="text-xs font-bold text-slate-400 mb-1 block">Nominal Harga (Dapat Diubah Manual)</label>
            <input type="number" value={price} onChange={(e) => setPrice(e.target.value)} className="w-full px-4 py-3 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-sm font-black text-blue-500" />
          </div>

          <div>
            <label className="text-xs font-bold text-slate-400 mb-1 block">Pelanggan Member</label>
            <select value={member} onChange={(e) => setMember(e.target.value)} className="w-full px-4 py-3 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold">
              <option value="Umum">Pelanggan Umum (Tanpa Poin)</option>
              <option value="Siti Rahma">Siti Rahma</option>
              <option value="Ahmad Fauzi">Ahmad Fauzi</option>
            </select>
          </div>

          <button type="submit" className="w-full py-4 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-sm shadow-xl shadow-blue-600/30 transition">
            Proses & Simpan Transaksi
          </button>
        </form>
      </div>
    </div>
  );
}
