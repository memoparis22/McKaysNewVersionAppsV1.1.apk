// 6. PROFILE TAB (Admin Control Hub)
// ============================================================================
function ProfileTab({ 
  currentUser, setCurrentUser, staffAccounts, setStaffAccounts, 
  branchInventory, setBranchInventory, members, setMembers, 
  transactions, masterPrices, setMasterPrices, stockOrders, setStockOrders,
  setPriceNotification, appLogo, setAppLogo, darkMode, setDarkMode, showToast 
}) {
  const isAdmin = currentUser.role === 'admin';

  const [newStaffUser, setNewStaffUser] = useState('');
  const [newStaffPass, setNewStaffPass] = useState('');
  const [newStaffBranch, setNewStaffBranch] = useState('');

  // Edit Staff Password State
  const [editingStaffId, setEditingStaffId] = useState(null);
  const [editStaffNewPass, setEditStaffNewPass] = useState('');

  // Bulk Upload State
  const [bulkBranch, setBulkBranch] = useState('Pusat');
  const [bulkText, setBulkText] = useState('');

  const handleImageUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => {
        setCurrentUser({ ...currentUser, profilePic: reader.result });
        showToast('Foto profil diperbarui!');
      };
      reader.readAsDataURL(file);
    }
  };

  const handleLogoUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => {
        setAppLogo(reader.result);
        showToast('Logo aplikasi berhasil diperbarui & disinkronkan!');
      };
      reader.readAsDataURL(file);
    }
  };

  const handleResetPoints = () => {
    if (confirm('Nol-kan semua poin member?')) {
      setMembers(members.map(m => ({ ...m, points: 0 })));
      showToast('Semua poin member dinolkan.');
    }
  };

  const handleBulkUpload = (e) => {
    e.preventDefault();
    if (!bulkText.trim()) return;

    const lines = bulkText.split('\n');
    let addedCount = 0;
    const currentInv = [...(branchInventory[bulkBranch] || [])];

    lines.forEach(line => {
      const parts = line.split(',');
      if (parts.length >= 1) {
        const name = parts[0].trim();
        const ml = parseFloat(parts[1]) || 50;
        const botol = parseFloat(parts[2]) || 20;

        if (name) {
          const existing = currentInv.find(i => i.name.toLowerCase() === name.toLowerCase());
          if (existing) {
            existing.stock_ml += ml;
            existing.stock_botol += botol;
          } else {
            currentInv.push({ id: Math.random().toString(), name, stock_ml: ml, stock_botol: botol });
          }
          addedCount++;
        }
      }
    });

    setBranchInventory({ ...branchInventory, [bulkBranch]: currentInv });
    setBulkText('');
    showToast(`Berhasil upload ${addedCount} produk ke ${bulkBranch}!`);
  };

  const handleAddStaff = (e) => {
    e.preventDefault();
    if (!newStaffUser || !newStaffPass || !newStaffBranch) return;

    setStaffAccounts([...staffAccounts, {
      id: Math.random().toString(),
      username: newStaffUser.trim(),
      password: newStaffPass.trim(),
      branch: newStaffBranch.trim()
    }]);

    if (!branchInventory[newStaffBranch.trim()]) {
      setBranchInventory({
        ...branchInventory,
        [newStaffBranch.trim()]: []
      });
    }

    setNewStaffUser('');
    setNewStaffPass('');
    setNewStaffBranch('');
    showToast('Cabang & Staff baru berhasil ditambahkan!');
  };

  const handleUpdateStaffPassword = (staffId) => {
    if (!editStaffNewPass.trim()) return;
    setStaffAccounts(staffAccounts.map(s => {
      if (s.id === staffId) {
        return { ...s, password: editStaffNewPass.trim() };
      }
      return s;
    }));
    setEditingStaffId(null);
    setEditStaffNewPass('');
    showToast('Password staff berhasil diperbarui!');
  };

  const handleApproveOrder = (ordId, approve) => {
    const updatedOrders = stockOrders.map(ord => {
      if (ord.id === ordId) {
        if (approve) {
          const branch = ord.branch;
          const currentInv = branchInventory[branch] || [];
          const existingItem = currentInv.find(i => i.name.toLowerCase() === ord.item.toLowerCase());

          let newInv = [...currentInv];
          if (existingItem) {
            newInv = newInv.map(i => i.id === existingItem.id ? { ...i, stock_ml: i.stock_ml + ord.ml, stock_botol: i.stock_botol + ord.botol } : i);
          } else {
            newInv.push({ id: Math.random().toString(), name: ord.item, stock_ml: ord.ml, stock_botol: ord.botol });
          }
          setBranchInventory({ ...branchInventory, [branch]: newInv });
        }
        return { ...ord, status: approve ? 'Disetujui' : 'Ditolak' };
      }
      return ord;
    });
    setStockOrders(updatedOrders);
    showToast(approve ? 'Order disetujui & stok masuk cabang!' : 'Order ditolak.');
  };

  const exportMonthlyReport = (type) => {
    let content = "No,Tanggal,Cabang,Produk,Harga,Member\n";
    transactions.forEach((tx, idx) => {
      content += `${idx + 1},${tx.date},${tx.branch},"${tx.item}",${tx.price},"${tx.member}"\n`;
    });
    const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.setAttribute("href", url);
    link.setAttribute("download", `Laporan_Bulanan_${new Date().toISOString().slice(0, 7)}.${type === 'excel' ? 'csv' : 'txt'}`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showToast(`Export ${type.toUpperCase()} Laporan Bulanan Berhasil!`);
  };

  return (
    <div className="p-4 max-w-md mx-auto space-y-6">
      <div className="flex justify-between items-center">
        <h2 className="text-lg font-black">Pengaturan Akun</h2>
        <button onClick={() => setDarkMode(!darkMode)} className="p-2 rounded-xl border dark:border-gray-800">
          {darkMode ? <Sun className="w-5 h-5 text-amber-400" /> : <Moon className="w-5 h-5" />}
        </button>
      </div>

      <div className={`p-6 rounded-3xl border text-center space-y-3 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
        <div className="relative w-20 h-20 mx-auto rounded-full bg-blue-600/25 flex items-center justify-center overflow-hidden border-2 border-blue-600">
          {currentUser.profilePic ? (
            <img src={currentUser.profilePic} alt="Profile" className="w-full h-full object-cover" />
          ) : (
            <span className="font-black text-xl text-blue-600">{currentUser.username.substring(0, 2).toUpperCase()}</span>
          )}
          <label className="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 hover:opacity-100 transition cursor-pointer text-white">
            <Camera className="w-6 h-6" />
            <input type="file" accept="image/*" onChange={handleImageUpload} className="hidden" />
          </label>
        </div>
        <div>
          <h3 className="font-extrabold text-base">{currentUser.username}</h3>
          <p className="text-xs text-blue-500 font-semibold">{isAdmin ? 'Admin Pusat' : `Staff Cabang: ${currentUser.branch}`}</p>
        </div>
      </div>

      {isAdmin && (
        <div className="space-y-4">
          <h3 className="text-xs font-bold text-slate-400 uppercase tracking-wider">Kontrol Master & Manajemen</h3>
          
          {/* Admin App Logo Uploader */}
          <div className={`p-4 rounded-3xl border space-y-3 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
            <h4 className="text-xs font-extrabold text-blue-500">Ubah Logo Aplikasi (Sinkron Semua Akun)</h4>
            <div className="flex items-center gap-4">
              <div className="w-12 h-12 rounded-2xl bg-blue-600 flex items-center justify-center text-white overflow-hidden border">
                {appLogo ? <img src={appLogo} alt="App Logo" className="w-full h-full object-cover" /> : 'M'}
              </div>
              <label className="flex-1 py-2.5 px-4 rounded-xl bg-blue-600 text-white font-bold text-xs text-center cursor-pointer shadow-md">
                Upload Logo Baru
                <input type="file" accept="image/*" onChange={handleLogoUpload} className="hidden" />
